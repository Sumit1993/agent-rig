{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/release-docs-gate.sh\"",
            "timeout": 20
          }
        ],
        "description": "Block merging a release PR on docs-governed repos without a fresh docs audit",
        "id": "pre:bash:release-docs-gate"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/no-haiku.sh\"",
            "timeout": 5
          }
        ],
        "description": "Block Agent calls with model=haiku (routing doctrine)",
        "id": "pre:agent:no-haiku"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/delegate-check.sh\"",
            "timeout": 5
          }
        ],
        "description": "Block a generic Claude subagent on delegable work unless agy was considered (AGENTS.md Delegation)",
        "id": "pre:agent:delegate-check"
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/organizer-seat.sh\"",
            "timeout": 5
          }
        ],
        "description": "Nudge once per session when the organizer edits files while an agy run is live",
        "id": "pre:edit:organizer-seat"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/no-broad-agy-kill.sh\"",
            "timeout": 5
          }
        ],
        "description": "Block pkill/killall targeting agy by name; they reap other sessions' runs as rc=137",
        "id": "pre:bash:no-broad-agy-kill"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reap-watchers.sh\" end",
            "timeout": 10
          }
        ],
        "description": "Kill watcher processes at session end so a resumed session never replays their events over a full context window",
        "id": "end:reap-watchers"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reap-watchers.sh\" start",
            "timeout": 10
          }
        ],
        "description": "Reap orphaned watcher processes (PPID 1) left by sessions that died without the SessionEnd hook",
        "id": "start:reap-orphan-watchers"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pr-created.sh\"",
            "timeout": 30
          }
        ],
        "description": "After a successful `gh pr create`, inject a reminder to arm the pr-watch monitor",
        "id": "post:bash:pr-created"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pr-created.sh\"",
            "timeout": 30
          }
        ],
        "description": "A delegated lane's PR surfaces in the handler's report, not in this session's Bash output; nudge the main session, which is the only seat that can hold a watcher",
        "id": "post:agent:pr-created"
      }
    ]
  }
}
