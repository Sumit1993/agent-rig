{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pre-push-cr-gate.sh\"",
            "timeout": 15
          }
        ],
        "description": "Gate `git push` on CodeRabbit-enabled repos behind a fresh CLI preview (scripts/cr-preview.sh)",
        "id": "pre:bash:cr-gate"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/no-haiku.sh\"",
            "timeout": 5
          }
        ],
        "description": "Block Agent calls with model=haiku (routing doctrine)",
        "id": "pre:agent:no-haiku"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pr-created.sh\"",
            "timeout": 10
          }
        ],
        "description": "After a successful `gh pr create`, inject a reminder to arm the pr-watch monitor",
        "id": "post:bash:pr-created"
      }
    ]
  }
}
