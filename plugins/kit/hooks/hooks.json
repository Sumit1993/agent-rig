{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/release-docs-gate.sh\"",
            "timeout": 20
          }
        ],
        "description": "Block merging a release PR on docs-governed repos without a fresh docs audit",
        "id": "pre:bash:release-docs-gate"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/no-haiku.sh\"",
            "timeout": 5
          }
        ],
        "description": "Block Agent calls with model=haiku (routing doctrine)",
        "id": "pre:agent:no-haiku"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/delegate-check.sh\"",
            "timeout": 5
          }
        ],
        "description": "Block a generic Claude subagent on delegable work unless agy was considered (AGENTS.md Delegation)",
        "id": "pre:agent:delegate-check"
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/organizer-seat.sh\"",
            "timeout": 5
          }
        ],
        "description": "Nudge once per session when the organizer edits files while an agy run is live",
        "id": "pre:edit:organizer-seat"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/no-broad-agy-kill.sh\"",
            "timeout": 5
          }
        ],
        "description": "Block pkill/killall targeting agy by name; they reap other sessions' runs as rc=137",
        "id": "pre:bash:no-broad-agy-kill"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gh-body-no-scratch.sh\"",
            "timeout": 10
          }
        ],
        "description": "Block gh issue/pr commands citing scratch paths (ai-context or /tmp)",
        "id": "pre:bash:gh-body-no-scratch"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/issue-create-nudge.sh\"",
            "timeout": 5
          }
        ],
        "description": "Nudge on third gh issue create this session to fold into an umbrella",
        "id": "pre:bash:issue-create-nudge"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/vendored-skill-nudge.sh\"",
            "timeout": 5
          }
        ],
        "description": "Inject record doctrine when vendored handoff/tickets/research skills load",
        "id": "pre:skill:vendored-skill-nudge"
      },
      {
        "matcher": "AskUserQuestion|EnterPlanMode|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/outside-view-nudge.sh\"",
            "timeout": 5
          }
        ],
        "description": "Nudge for an outside view when an agent asks, plans, or spawns the planner; 1st then every 3rd per session",
        "id": "pre:any:outside-view-nudge"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-no-stall.sh\"",
            "timeout": 10
          }
        ],
        "description": "Block subagents returning stall phrasing instead of waiting in the foreground",
        "id": "stop:subagent-no-stall"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reap-watchers.sh\" end",
            "timeout": 10
          }
        ],
        "description": "Kill watcher processes at session end so a resumed session never replays their events over a full context window",
        "id": "end:reap-watchers"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reap-watchers.sh\" start",
            "timeout": 10
          }
        ],
        "description": "Reap orphaned watcher processes (PPID 1) left by sessions that died without the SessionEnd hook",
        "id": "start:reap-orphan-watchers"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-budget.sh\"",
            "timeout": 10
          }
        ],
        "description": "One line of budget at session start: 5h and 7d percent from the statusline trace, agy quota per group, and the cheap-mode policy",
        "id": "start:session-budget"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pr-created.sh\"",
            "timeout": 30
          }
        ],
        "description": "After a successful `gh pr create`, inject a reminder to arm the pr-watch monitor",
        "id": "post:bash:pr-created"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pr-created.sh\"",
            "timeout": 30
          }
        ],
        "description": "A delegated lane's PR surfaces in the handler's report, not in this session's Bash output; nudge the main session, which is the only seat that can hold a watcher",
        "id": "post:agent:pr-created"
      }
    ]
  }
}
