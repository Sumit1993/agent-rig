{
  "prismalens/gh-workflows": {
    "coderabbit": true,
    "coderabbit_auto_review": true,
    "claude_lane": false,
    "fixer_lane": false,
    "merge_queue": false,
    "enforced": false,
    "canon": null
  },
  "Sumit1993/mage-memory": {
    "coderabbit": true,
    "coderabbit_auto_review": false,
    "claude_lane": true,
    "fixer_lane": false,
    "merge_queue": false,
    "enforced": true,
    "canon": "prismalens/gh-workflows",
    "docs": {
      "site": "docs/src/content/docs",
      "surfaces": [
        "README.md",
        "AGENTS.md",
        "CLAUDE.md",
        "CONVENTIONS.md",
        "docs/src/content/docs/",
        "src/cli-program.ts (help strings)",
        "skills/*/SKILL.md",
        "package.json (description)"
      ],
      "code_globs": [
        "src/**"
      ]
    }
  },
  "prismalens/sreforge": {
    "coderabbit": true,
    "coderabbit_auto_review": false,
    "claude_lane": true,
    "fixer_lane": false,
    "merge_queue": true,
    "enforced": true,
    "canon": "prismalens/gh-workflows",
    "docs": {
      "site": "docs/src/content/docs",
      "surfaces": [
        "README.md",
        "CONTRIBUTING.md",
        "docs/src/content/docs/reference/cli.md",
        "docs/src/content/docs/",
        "tools/*/README.md",
        "use-cases/** (Taskfile desc lines)",
        "CLI usage strings"
      ],
      "code_globs": [
        "tools/**",
        "use-cases/**",
        "infra/**",
        "core/src/**"
      ]
    }
  },
  "prismalens/prismalens": {
    "coderabbit": true,
    "coderabbit_auto_review": false,
    "claude_lane": true,
    "fixer_lane": false,
    "merge_queue": true,
    "enforced": true,
    "canon": "prismalens/gh-workflows",
    "docs": {
      "surfaces": [
        "README.md",
        "packages/cli/README.md",
        "packages/@prismalens/config/README.md",
        "packages/@prismalens/engine/README.md",
        "packages/@prismalens/contracts/README.md",
        "ROADMAP.md",
        "CONTRIBUTING.md"
      ],
      "code_globs": [
        "packages/*/src/**",
        "packages/@prismalens/*/src/**"
      ]
    }
  }
}
