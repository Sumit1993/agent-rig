{
  "permissions": {
    "allow": ["Bash(agy *)"],
    "deny": [
      "WebFetch",
      "Bash(npm run dev*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm run dev*)",
      "Bash(bun dev*)",
      "Bash(bun run dev*)",
      "Bash(next dev*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "worktree": { "baseRef": "head" },
  "effortLevel": "high",
  "tui": "fullscreen",
  "extraKnownMarketplaces": {
    "agent-rig": {
      "source": { "source": "github", "repo": "Sumit1993/agent-rig" },
      "autoUpdate": true
    },
    "mattpocock": {
      "source": { "source": "github", "repo": "mattpocock/skills" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "rig@agent-rig": true,
    "mattpocock-skills@mattpocock": true
  }
}
