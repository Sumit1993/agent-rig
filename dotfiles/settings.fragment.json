{
  "permissions": {
    "allow": ["Bash(agy *)"],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "extraKnownMarketplaces": {
    "claude-kit": {
      "source": { "source": "github", "repo": "Sumit1993/claude-kit" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "kit@claude-kit": true
  }
}
